{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../scripts/sync-model.mjs",
    "dev": "next dev",
    "prebuild": "node ../scripts/sync-model.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:scoring": "tsx scripts/smoke-scoring.ts",
    "sync-model": "node ../scripts/sync-model.mjs",
    "db:gen-postgres": "node scripts/gen-postgres-schema.mjs",
    "db:setup:postgres": "cross-env PRISMA_SCHEMA=prisma/schema.postgres.prisma prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed-users": "tsx prisma/seed-users.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
