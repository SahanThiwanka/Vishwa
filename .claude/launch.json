{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "appraisal-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000
    },
    {
      "name": "thesis-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8777",
        "--directory",
        "docs/06-thesis"
      ],
      "port": 8777
    },
    {
      "name": "appraisal-web-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "DATABASE_URL=file:./dev.db",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "appraisal-web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "DATABASE_URL=file:./dev.db",
        "npm",
        "--prefix",
        "web",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
